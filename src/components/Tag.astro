---
interface Props {
  color?: 'amber' | 'neutral' | 'accent';
  active?: boolean;
  onClick?: string;
  class?: string;
  [key: string]: any;
}

const { color = 'amber', active = false, class: className = '', ...props } = Astro.props;
---

<span
  class:list={[
    'tag-pill',
    `tag-${color}`,
    { active },
    className
  ]}
  {...props}
>
  <slot />
</span>

<style>
  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
    transition: all var(--dur-base) var(--ease-out);
    user-select: none;
  }

  .tag-amber {
    color: var(--amber);
    background: var(--amber-dim);
    border-color: rgba(251, 146, 60, 0.2);
  }

  .tag-neutral {
    color: var(--fg-2);
    background: var(--bg-2);
    border-color: var(--line-1);
  }

  .tag-accent {
    color: var(--accent);
    background: var(--accent-dim);
    border-color: rgba(96, 165, 250, 0.2);
  }

  .tag-pill.active {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent-strong);
    font-weight: 600;
  }

  button.tag-pill, a.tag-pill, span.tag-pill[data-clickable] {
    cursor: pointer;
  }

  button.tag-pill:hover, a.tag-pill:hover, span.tag-pill[data-clickable]:hover {
    transform: translateY(-1px);
    border-color: var(--border-strong);
  }
</style>
