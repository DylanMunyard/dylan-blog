---
interface GalleryItem {
  src: string;
  alt?: string;
  title?: string;
  kicker?: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
  minCol?: number;
  aspect?: string;
  captions?: boolean;
}

const { items, minCol = 260, aspect = '16 / 10', captions = true } = Astro.props;
---

<div class="gallery-grid" style={`grid-template-columns: repeat(auto-fill, minmax(${minCol}px, 1fr))`}>
  {items.map((item, i) => (
    <figure
      class="gallery-item"
      data-index={i}
      data-src={item.src}
      data-title={item.title ?? item.alt ?? ''}
      data-kicker={item.kicker ?? ''}
      data-caption={item.caption ?? ''}
    >
      <div class="gallery-thumb" style={`aspect-ratio: ${aspect}`}>
        <img src={item.src} alt={item.alt ?? item.title ?? ''} loading="lazy" />
        <div class="gallery-expand-icon">⤢</div>
        <div class="gallery-thumb-fade"></div>
      </div>
      {captions && (item.title || item.kicker) && (
        <figcaption class="gallery-caption">
          {item.title && <span class="gallery-caption-title">{item.title}</span>}
          {item.kicker && <span class="gallery-caption-kicker">{item.kicker}</span>}
        </figcaption>
      )}
    </figure>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    gap: 16px;
    margin: 32px 0 8px;
  }

  .gallery-item {
    margin: 0;
    cursor: pointer;
    background: var(--surface-card);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .gallery-item:hover {
    border-color: var(--line-2);
    transform: translateY(-3px);
    box-shadow: var(--shadow-raised);
  }

  .gallery-thumb {
    position: relative;
    overflow: hidden;
    background: var(--bg-2);
  }

  .gallery-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-expand-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(9, 14, 26, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--line-2);
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--accent);
  }

  .gallery-thumb-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44px;
    background: linear-gradient(180deg, transparent, rgba(7, 10, 18, 0.55));
  }

  .gallery-caption {
    padding: 13px 15px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gallery-caption-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--fg-1);
    line-height: 1.3;
  }

  .gallery-caption-kicker {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
</style>

<style is:global>
  /* Lightbox is built at runtime and appended to <body>, so it lives outside
     this component's scoped styles — these rules are unscoped on purpose. */
  @keyframes gallery-lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes gallery-lb-pop {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
  }

  .gallery-lightbox-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(5, 8, 15, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 28px;
    animation: gallery-lb-fade 0.18s var(--ease-out);
  }

  .gallery-lightbox-close {
    position: absolute;
    top: 22px;
    right: 26px;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: rgba(17, 23, 38, 0.7);
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--dur-fast) var(--ease-out);
  }

  .gallery-lightbox-close:hover {
    color: var(--fg-1);
    border-color: var(--accent);
  }

  .gallery-lightbox-counter {
    position: absolute;
    top: 26px;
    left: 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--amber);
  }

  .gallery-lightbox-content {
    display: flex;
    align-items: center;
    gap: 22px;
    max-width: 1240px;
    width: 100%;
    justify-content: center;
    animation: gallery-lb-pop 0.22s var(--ease-out);
  }

  .gallery-lightbox-nav {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: rgba(17, 23, 38, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--fg-1);
    font-family: var(--font-mono);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.18s var(--ease-out), border-color 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }

  .gallery-lightbox-nav:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .gallery-lightbox-nav[hidden] {
    display: none;
  }

  .gallery-lightbox-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    flex: 1 1 auto;
    max-width: 1040px;
  }

  .gallery-lightbox-img-wrap {
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-raised);
    background: var(--bg-1);
  }

  .gallery-lightbox-img-wrap img {
    display: block;
    width: 100%;
    max-height: 68vh;
    object-fit: contain;
    background: var(--bg-0);
  }

  .gallery-lightbox-caption {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 2px 4px;
  }

  .gallery-lightbox-kicker {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .gallery-lightbox-kicker[hidden],
  .gallery-lightbox-detail[hidden] {
    display: none;
  }

  .gallery-lightbox-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    color: var(--fg-1);
  }

  .gallery-lightbox-detail {
    margin: 0;
    max-width: 70ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg-2);
  }
</style>

<script>
  interface GalleryItemData {
    src: string;
    title: string;
    kicker: string;
    caption: string;
  }

  function initGalleries() {
    document.querySelectorAll<HTMLElement>('.gallery-grid:not([data-gallery-init])').forEach((grid) => {
      grid.setAttribute('data-gallery-init', 'true');

      const items: GalleryItemData[] = Array.from(grid.querySelectorAll<HTMLElement>('.gallery-item')).map((el) => ({
        src: el.getAttribute('data-src') || '',
        title: el.getAttribute('data-title') || '',
        kicker: el.getAttribute('data-kicker') || '',
        caption: el.getAttribute('data-caption') || '',
      }));

      let openIndex = 0;
      let backdrop: HTMLElement | null = null;
      let imgEl: HTMLImageElement;
      let titleEl: HTMLElement;
      let kickerEl: HTMLElement;
      let captionEl: HTMLElement;
      let counterEl: HTMLElement;
      let prevBtn: HTMLButtonElement;
      let nextBtn: HTMLButtonElement;

      const render = () => {
        const item = items[openIndex];
        imgEl.src = item.src;
        imgEl.alt = item.title;
        titleEl.textContent = item.title;
        kickerEl.textContent = item.kicker;
        kickerEl.hidden = !item.kicker;
        captionEl.textContent = item.caption;
        captionEl.hidden = !item.caption;
        counterEl.textContent = `${String(openIndex + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
      };

      const step = (delta: number) => {
        openIndex = (openIndex + delta + items.length) % items.length;
        render();
      };

      const onKeyDown = (e: KeyboardEvent) => {
        if (!backdrop) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') {
          e.preventDefault();
          step(1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          step(-1);
        }
      };

      const close = () => {
        backdrop?.remove();
        backdrop = null;
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeyDown);
      };

      const open = (index: number) => {
        openIndex = index;

        backdrop = document.createElement('div');
        backdrop.className = 'gallery-lightbox-backdrop';
        backdrop.addEventListener('click', (ev) => {
          if (ev.target === backdrop) close();
        });

        const closeBtn = document.createElement('button');
        closeBtn.className = 'gallery-lightbox-close';
        closeBtn.type = 'button';
        closeBtn.textContent = '✕';
        closeBtn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          close();
        });

        counterEl = document.createElement('div');
        counterEl.className = 'gallery-lightbox-counter';

        const content = document.createElement('div');
        content.className = 'gallery-lightbox-content';
        content.addEventListener('click', (ev) => ev.stopPropagation());

        prevBtn = document.createElement('button');
        prevBtn.className = 'gallery-lightbox-nav';
        prevBtn.type = 'button';
        prevBtn.textContent = '‹';
        prevBtn.hidden = items.length <= 1;
        prevBtn.addEventListener('click', () => step(-1));

        nextBtn = document.createElement('button');
        nextBtn.className = 'gallery-lightbox-nav';
        nextBtn.type = 'button';
        nextBtn.textContent = '›';
        nextBtn.hidden = items.length <= 1;
        nextBtn.addEventListener('click', () => step(1));

        const figureEl = document.createElement('figure');
        figureEl.className = 'gallery-lightbox-figure';

        const imgWrap = document.createElement('div');
        imgWrap.className = 'gallery-lightbox-img-wrap';
        imgEl = document.createElement('img');
        imgWrap.appendChild(imgEl);

        const figcaptionEl = document.createElement('figcaption');
        figcaptionEl.className = 'gallery-lightbox-caption';
        kickerEl = document.createElement('div');
        kickerEl.className = 'gallery-lightbox-kicker';
        titleEl = document.createElement('div');
        titleEl.className = 'gallery-lightbox-title';
        captionEl = document.createElement('p');
        captionEl.className = 'gallery-lightbox-detail';
        figcaptionEl.append(kickerEl, titleEl, captionEl);

        figureEl.append(imgWrap, figcaptionEl);
        content.append(prevBtn, figureEl, nextBtn);
        backdrop.append(closeBtn, counterEl, content);

        document.body.appendChild(backdrop);
        document.body.style.overflow = 'hidden';
        document.addEventListener('keydown', onKeyDown);

        render();
      };

      grid.querySelectorAll<HTMLElement>('.gallery-item').forEach((fig, i) => {
        fig.addEventListener('click', () => open(i));
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleries);
  } else {
    initGalleries();
  }
  document.addEventListener('astro:page-load', initGalleries);
</script>
