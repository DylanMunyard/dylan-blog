---
interface Props {
  kind?: 'tip' | 'info' | 'warn' | 'danger';
  title?: string;
}

const { kind = 'tip', title } = Astro.props;

const config = {
  tip: { label: 'TIP', colorVar: '--success', dimVar: '--success-dim', borderVar: 'rgba(110, 231, 183, 0.25)' },
  info: { label: 'INFO', colorVar: '--info', dimVar: '--info-dim', borderVar: 'rgba(125, 211, 252, 0.25)' },
  warn: { label: 'WARNING', colorVar: '--warn', dimVar: '--warn-dim', borderVar: 'rgba(251, 146, 60, 0.25)' },
  danger: { label: 'DANGER', colorVar: '--danger', dimVar: '--danger-dim', borderVar: 'rgba(253, 164, 175, 0.25)' }
}[kind];
---

<aside class={`callout callout-${kind}`}>
  <div class="callout-header">
    <span class="callout-badge">{config.label}</span>
    {title && <span class="callout-title">{title}</span>}
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 28px 0;
    padding: 20px 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-1);
    background: var(--bg-2);
  }

  .callout-tip {
    background: var(--success-dim);
    border-color: rgba(110, 231, 183, 0.25);
  }
  .callout-info {
    background: var(--info-dim);
    border-color: rgba(125, 211, 252, 0.25);
  }
  .callout-warn {
    background: var(--warn-dim);
    border-color: rgba(251, 146, 60, 0.25);
  }
  .callout-danger {
    background: var(--danger-dim);
    border-color: rgba(253, 164, 175, 0.25);
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .callout-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
  }

  .callout-tip .callout-badge { color: var(--success); }
  .callout-info .callout-badge { color: var(--info); }
  .callout-warn .callout-badge { color: var(--warn); }
  .callout-danger .callout-badge { color: var(--danger); }

  .callout-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--fg-1);
  }

  .callout-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-1);
  }

  .callout-body :global(p) {
    margin: 0;
  }

  .callout-body :global(p + p) {
    margin-top: 12px;
  }
</style>
