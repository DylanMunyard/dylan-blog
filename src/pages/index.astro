---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Tag from '../components/Tag.astro';

// Get non-draft posts sorted by date
const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect unique categories/tags across all posts
const categoriesSet = new Set<string>();
sortedPosts.forEach((post) => {
  if (post.data.tags) {
    post.data.tags.forEach((t) => categoriesSet.add(t));
  }
});
const categories = ['all', ...Array.from(categoriesSet)];

// Format helpers
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(date);
};

const calculateReadingTime = (content: string) => {
  const words = content.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min read`;
};
---

<BaseLayout title="Dylan Munyard — Dylan's blog | Senior Consultant @ SixPivot">
  <div class="home-container">
    <section class="hero-section">
      <div class="subtitle">~ a lab notebook</div>
      <h1 class="hero-title">Dylan's blog | Senior Consultant @ SixPivot.</h1>
      
      <div class="tag-filter-bar">
        {categories.map((cat) => (
          <button
            class={`tag-filter-btn ${cat === 'all' ? 'active' : ''}`}
            data-category={cat}
          >
            <Tag color={cat === 'all' ? undefined : 'neutral'} active={cat === 'all'}>
              {cat}
            </Tag>
          </button>
        ))}
      </div>
    </section>

    <section class="posts-grid" id="posts-grid">
      {sortedPosts.map((post) => (
        <div class="post-card-wrapper" data-tags={JSON.stringify(post.data.tags || [])}>
          <PostCard
            title={post.data.title}
            date={formatDate(post.data.date)}
            readTime={calculateReadingTime(post.body)}
            excerpt={post.data.description}
            categories={post.data.tags || []}
            image={post.data.image}
            href={`/posts/${post.slug}`}
          />
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 32px 96px;
  }

  .hero-section {
    padding: 96px 0 64px;
  }

  .subtitle {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--amber);
  }

  .hero-title {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-1);
    max-width: 800px;
  }

  .hero-bio {
    margin: 20px 0 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--fg-2);
    max-width: 56ch;
  }

  .tag-filter-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 36px;
  }

  .tag-filter-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .post-card-wrapper {
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .post-card-wrapper.hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-section {
      padding: 48px 0 36px;
    }
  }
</style>

<script>
  // Client-side tag filtering
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
  const postCards = document.querySelectorAll<HTMLDivElement>('.post-card-wrapper');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedCategory = btn.getAttribute('data-category');

      // Update active states
      filterBtns.forEach((b) => {
        const isSelected = b.getAttribute('data-category') === selectedCategory;
        b.classList.toggle('active', isSelected);
        const tagPill = b.querySelector('.tag-pill');
        if (tagPill) {
          tagPill.classList.toggle('active', isSelected);
        }
      });

      // Filter cards
      postCards.forEach((card) => {
        const tags: string[] = JSON.parse(card.getAttribute('data-tags') || '[]');
        if (selectedCategory === 'all' || tags.includes(selectedCategory!)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
