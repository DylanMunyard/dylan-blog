---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParallaxBackdrop from '../../components/ParallaxBackdrop.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await post.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Format date
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).format(date);
};

// Calculate reading time
const calculateReadingMinutes = (content: string) => {
  const words = content.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
};

const readingMinutes = calculateReadingMinutes(post.body);
const bgImage = post.data.image || '/assets/backgrounds/jwst-nebula.png';
---

<BaseLayout title={`${post.data.title} — Dylan Munyard`} description={post.data.description}>
  <ParallaxBackdrop image={bgImage} dim={0.35}>
    <div class="post-container">
      <article class="post-scrim">
        <a href="/" class="back-link">← all posts</a>

        <div class="post-header-meta">
          {formatDate(post.data.date)} · {readingMinutes} min read
        </div>

        <h1 class="post-title">{post.data.title}</h1>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <Tag color="amber">{tag}</Tag>
            ))}
          </div>
        )}

        <div class="post-content">
          <Content />
        </div>

        <div class="post-footer-actions">
          <a href="/" class="btn btn-primary">← Back to posts</a>
          <a href="https://github.com/DylanMunyard/dylan-blog" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            View source ↗
          </a>
        </div>
      </article>
    </div>

    {tocHeadings.length > 2 && (
      <nav class="post-nav" aria-label="Table of contents" data-toc-root data-toc-read-min={readingMinutes}>
        <button type="button" class="post-nav-header" data-toc-header aria-expanded="false" aria-controls="post-nav-list">
          <div class="post-nav-ring" data-toc-ring>
            <div class="post-nav-ring-inner"><span data-toc-pct>0</span></div>
          </div>
          <div class="post-nav-meta">
            <span class="post-nav-label">On this page</span>
            <span class="post-nav-current" data-toc-current>{tocHeadings[0].text}</span>
            <span class="post-nav-time" data-toc-time>{readingMinutes} min left</span>
          </div>
          <span class="post-nav-toggle" aria-hidden="true">⌃</span>
        </button>
        <div class="post-nav-list" id="post-nav-list">
          <ul>
            {tocHeadings.map((h) => (
              <li>
                <a class={`post-nav-item toc-depth-${h.depth}`} href={`#${h.slug}`} data-toc-link data-toc-slug={h.slug}>
                  <span class="post-nav-dot"></span>
                  <span class="post-nav-item-text">{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}
  </ParallaxBackdrop>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-toc-root]');

  if (root) {
    const readMin = Number(root.dataset.tocReadMin ?? '0');
    const ring = root.querySelector<HTMLElement>('[data-toc-ring]');
    const pctEl = root.querySelector<HTMLElement>('[data-toc-pct]');
    const currentEl = root.querySelector<HTMLElement>('[data-toc-current]');
    const timeEl = root.querySelector<HTMLElement>('[data-toc-time]');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const headingEls = links
      .map((link) => document.getElementById(link.dataset.tocSlug ?? ''))
      .filter((el): el is HTMLElement => el !== null);
    const header = root.querySelector<HTMLButtonElement>('[data-toc-header]');
    const mobileQuery = window.matchMedia('(max-width: 1599px)');

    header?.addEventListener('click', () => {
      if (!mobileQuery.matches) return;
      const expanded = root.classList.toggle('expanded');
      header.setAttribute('aria-expanded', String(expanded));
    });

    mobileQuery.addEventListener('change', (e) => {
      if (!e.matches) {
        root.classList.remove('expanded');
        header?.setAttribute('aria-expanded', 'false');
      }
    });

    let ticking = false;

    const recompute = () => {
      ticking = false;

      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      const pct = Math.round(progress * 100);

      let activeIdx = 0;
      headingEls.forEach((el, i) => {
        if (el.getBoundingClientRect().top <= 140) activeIdx = i;
      });

      if (ring) ring.style.background = `conic-gradient(var(--accent) ${pct * 3.6}deg, var(--line-2) 0)`;
      if (pctEl) pctEl.textContent = String(pct);
      if (currentEl) currentEl.textContent = links[activeIdx]?.textContent?.trim() ?? '';
      if (timeEl) timeEl.textContent = `${Math.max(0, Math.ceil(readMin * (1 - progress)))} min left`;

      links.forEach((link, i) => link.classList.toggle('active', i === activeIdx));
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(recompute);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    requestAnimationFrame(recompute);

    for (const link of links) {
      link.addEventListener('click', (e) => {
        const slug = link.dataset.tocSlug;
        const target = slug ? document.getElementById(slug) : null;
        if (target) {
          e.preventDefault();
          const top = target.getBoundingClientRect().top + window.scrollY - 96;
          window.scrollTo({ top, behavior: 'smooth' });
          history.pushState(null, '', `#${slug}`);
        }
      });
    }
  }
</script>

<style>
  .post-container {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 72px 24px 96px;
  }

  .post-nav {
    display: flex;
    flex-direction: column;
    position: fixed;
    z-index: 6;
    max-height: 80vh;
    overflow-y: auto;
    padding: 13px 15px;
    border-radius: 13px;
    border: 1px solid var(--line-1);
    background: rgba(17, 23, 38, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--shadow-card);
    transition: width var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .post-nav-header {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 12px;
    border: none;
    background: none;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .post-nav-header:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .post-nav-toggle {
    display: none;
    flex: none;
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-3);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .post-nav.expanded .post-nav-toggle {
    transform: rotate(180deg);
  }

  .post-nav-ring {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition: background var(--dur-base) linear;
  }

  .post-nav-ring-inner {
    position: absolute;
    inset: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bg-3);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--fg-1);
  }

  .post-nav-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--amber);
  }

  .post-nav-current {
    max-width: 158px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--fg-1);
  }

  .post-nav-time {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--fg-3);
  }

  .post-nav-list {
    order: 1;
    max-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height var(--dur-slow) var(--ease-out), opacity var(--dur-base) var(--ease-out), margin-top var(--dur-slow) var(--ease-out), margin-bottom var(--dur-slow) var(--ease-out);
  }

  .post-nav-list ul {
    list-style: none;
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--line-1);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .post-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 7px;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .post-nav-item.toc-depth-3 {
    padding-left: 26px;
  }

  .post-nav-item.active {
    background: var(--accent-dim);
  }

  .post-nav-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line-2);
    transition: background var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .post-nav-item.active .post-nav-dot {
    background: var(--accent);
    box-shadow: 0 0 8px 1px rgba(96, 165, 250, 0.75);
  }

  .post-nav-item-text {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-2);
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .post-nav-item.toc-depth-3 .post-nav-item-text {
    font-size: 12px;
  }

  .post-nav-item.active .post-nav-item-text {
    color: var(--fg-1);
  }

  .post-nav::-webkit-scrollbar {
    width: 0;
  }

  /* Only float the nav beside the content column once there's genuine
     breathing room there (content-max + expanded width + gap on both sides).
     Below that, it collapses into a bottom-right chip instead. */
  @media (min-width: 1600px) {
    .post-nav {
      top: 50%;
      left: calc(50vw + (var(--content-max) / 2) - 8px);
      right: auto;
      bottom: auto;
      transform: translateY(-50%);
      width: auto;
    }

    .post-nav:hover,
    .post-nav:focus-within {
      width: 248px;
      border-color: var(--line-2);
      box-shadow: var(--shadow-raised);
    }

    .post-nav:hover .post-nav-list,
    .post-nav:focus-within .post-nav-list {
      max-height: 460px;
      margin-top: 14px;
      opacity: 1;
    }

    .post-nav-header {
      cursor: default;
    }

    .post-nav-toggle {
      display: none !important;
    }
  }

  @media (max-width: 1599px) {
    .post-nav {
      top: auto;
      left: auto;
      right: 16px;
      bottom: 20px;
      width: auto;
      max-width: calc(100vw - 32px);
    }

    .post-nav.expanded {
      width: min(300px, calc(100vw - 32px));
      border-color: var(--line-2);
      box-shadow: var(--shadow-raised);
    }

    .post-nav-list {
      order: -1;
    }

    .post-nav.expanded .post-nav-list {
      max-height: 460px;
      margin-bottom: 14px;
      opacity: 1;
    }

    .post-nav-list ul {
      padding-top: 0;
      padding-bottom: 12px;
      border-top: none;
      border-bottom: 1px solid var(--line-1);
    }

    .post-nav-toggle {
      display: inline-flex;
      align-items: center;
    }
  }

  .post-scrim {
    background: var(--scrim-content);
    backdrop-filter: blur(var(--scrim-blur));
    -webkit-backdrop-filter: blur(var(--scrim-blur));
    border: 1px solid var(--line-1);
    border-radius: var(--radius-lg);
    padding: 56px 56px 64px;
    box-shadow: var(--shadow-raised);
    overflow: hidden;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-3);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .post-header-meta {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--amber);
  }

  .post-title {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-1);
  }

  .post-tags {
    display: flex;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .post-content {
    margin-top: 36px;
  }

  .post-footer-actions {
    display: flex;
    gap: 12px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line-1);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all var(--dur-fast) var(--ease-out);
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    border: 1px solid var(--accent-strong);
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-strong);
    color: #fff;
    text-decoration: none;
  }

  .btn-secondary {
    background: var(--bg-2);
    color: var(--fg-1);
    border: 1px solid var(--line-1);
  }

  .btn-secondary:hover {
    background: var(--bg-3);
    border-color: var(--line-2);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .post-container {
      padding: 0 0 48px;
      width: 100%;
      max-width: 100%;
    }
    .post-scrim {
      border-radius: 0;
      border-left: none;
      border-right: none;
      padding: 28px 20px 40px;
      background: rgba(9, 14, 26, 0.94);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }
    .post-title {
      font-size: 2.125rem;
    }
    .post-footer-actions {
      flex-direction: column;
    }
  }
</style>
